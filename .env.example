# Copy to .env and fill in.  ->  cp .env.example .env

# --- required --------------------------------------------------------------

# HOST path of the PARENT directory where the NAS mounts USB disks (NOT a
# specific disk). Bind-mounted read-only with rslave propagation so plugging /
# unplugging the external drive is detected live, without restarting.
# On UGREEN UGOS Pro this is usually /mnt/@usb . Confirm with, over SSH:
#   ls /mnt/@usb/    (or)    lsblk -o NAME,MOUNTPOINT,SIZE,LABEL
IMPORT_HOST_PATH=/mnt/@usb

# Immich API key (Account Settings -> API Keys in the Immich web UI).
IMMICH_API_KEY=changeme

# --- optional --------------------------------------------------------------

# Immich server URL as reachable from INSIDE the docker network.
# Container name is `immich_server` (underscore) on the immich_default network,
# so the internal service URL is http://immich_server:2283.
# You could also point straight at the host: http://192.168.1.85:2283
IMMICH_URL=http://immich_server:2283

# External docker network created by your Immich compose stack.
# Find it with:  docker network ls | grep immich
IMMICH_NETWORK=immich_default

# Album strategy: FOLDER (album per leaf folder) | PATH (full path) | NONE
ALBUM_MODE=FOLDER
